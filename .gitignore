play-config.json
.DS_Store
.gen3d/
# Runtime reel scenario state, auto-created by the wb-reel plugin under each
# game's reel/ (scenarios.json + versions/) on first Studio load. Not source —
# .forgeax/games/<slug> symlinks back here, so writes land in this submodule.
reel/
node_modules/
# node_modules as a SYMLINK (dev typecheck convenience) — the dir pattern
# above misses symlinks, so match the bare name too.
node_modules
# runtime chat/session state, auto-created under each game dir by Studio
sessions/

# Studio runtime/DDC cache for Rain Alley; source assets live under rain-alley/assets.
rain-alley/.forgeax/

# Playwright CLI test artifacts (console/snapshot logs), not source
.playwright-cli/

# Hellforge local 2K originals + deferred cook copies (~330MB). Engine scanner
# already blacklists this dirname; never commit. Remote 2K SSOT is git tag
# hellforge-textures-2k-20260813 — see hellforge/docs/handoff/2026-08-13-1k-textures-and-2k-restore.md
hellforge/.forgeax-asset-cache/

# Shell UI raw masters (Downloads cutouts kept local)
hellforge/assets/ui/shell/_masters/
