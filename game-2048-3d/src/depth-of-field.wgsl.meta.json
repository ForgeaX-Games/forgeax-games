{
  "schemaVersion": "1.0.0",
  "kind": "external-asset-package",
  "importer": "shader",
  "source": "depth-of-field.wgsl",
  "importSettings": {
    "postProcessIdentifier": "game-default::depth-of-field"
  },
  "subAssets": [],
